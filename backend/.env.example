# ProjectForge backend configuration
# Duplicate this file as `.env` and fill in your own values.
# Never commit the real `.env` file.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=projectforge
PORT=5000

# Contact email shown in the footer (served via GET /api/config).
# Leave empty to hide the contact link.
CONTACT_EMAIL=